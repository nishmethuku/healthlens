VITE_API_URL=http://localhost:8000

# Known limitation: this gets baked into the built JS bundle, so it is
# readable by anyone who opens devtools on a deployed build — it is NOT a
# real secret in a public SPA. It only deters casual/automated abuse of the
# API, not a determined attacker. A real fix is per-user auth or a
# backend-for-frontend proxy that holds the actual secret server-side.
VITE_HEALTHLENS_API_KEY=your_healthlens_api_key_here
