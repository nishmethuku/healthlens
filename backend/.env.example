ENVIRONMENT=development

GROQ_API_KEY=your_groq_api_key_here
NCBI_API_KEY=your_ncbi_api_key_here

# Required to call /api/v1/query — requests must send this in the X-API-Key
# header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTHLENS_API_KEY=your_healthlens_api_key_here

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Sentence embedding model (swap requires deleting backend/data/index_cache/
# so the corpus re-embeds under the new model). NeuML/pubmedbert-base-embeddings
# was tried and reverted 2026-08-10 — see config.py for why.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
