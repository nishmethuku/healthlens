ENVIRONMENT=development

GROQ_API_KEY=your_groq_api_key_here
NCBI_API_KEY=your_ncbi_api_key_here

# Required to call /api/v1/query — requests must send this in the X-API-Key
# header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTHLENS_API_KEY=your_healthlens_api_key_here

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Sentence embedding model. Changing it (or the document prefix) builds a new
# index cache entry automatically. Models like e5 need prefixes, e.g.
# EMBEDDING_QUERY_PREFIX="query: " and EMBEDDING_DOC_PREFIX="passage: ".
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=

# How BM25 and dense scores are combined: weighted or rrf. Compare both with
# eval/eval_harness.py (modes hybrid and hybrid_rrf) before switching.
FUSION_METHOD=weighted
DENSE_WEIGHT=0.5
RERANK_POOL_SIZE=25

# Set true to use keyword-only retrieval (no embedding model), for small hosts
LITE_MODE=false
